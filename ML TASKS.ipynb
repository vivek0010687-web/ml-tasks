"""
California Housing Price Prediction
-----------------------------------
Compares Linear Regression, Ridge Regression, and Decision Tree Regression
using the scikit-learn California Housing dataset.

Run:
    pip install -r requirements.txt
    python house_price_prediction.py

The target, MedHouseVal, is expressed in units of $100,000.
"""

from pathlib import Path
import joblib
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

from sklearn.datasets import fetch_california_housing
from sklearn.linear_model import LinearRegression, Ridge
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.tree import DecisionTreeRegressor


RANDOM_STATE = 42
TEST_SIZE = 0.20
OUTPUT_DIR = Path("outputs")
MODEL_PATH = Path("best_house_price_model.joblib")


def load_data():
    """Load the California Housing dataset as a pandas DataFrame."""
    dataset = fetch_california_housing(as_frame=True)
    df = dataset.data.copy()
    df["MedHouseVal"] = dataset.target
    return df


def save_eda_plots(df):
    """Save target distribution, feature correlations, and geographic plots."""
    OUTPUT_DIR.mkdir(exist_ok=True)

    plt.figure(figsize=(8, 5))
    sns.histplot(df["MedHouseVal"], bins=40, kde=True)
    plt.title("Distribution of Median House Values")
    plt.xlabel("Median house value (units of $100,000)")
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / "target_distribution.png", dpi=150)
    plt.close()

    plt.figure(figsize=(10, 8))
    sns.heatmap(df.corr(numeric_only=True), cmap="coolwarm", center=0)
    plt.title("Feature Correlation Heatmap")
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / "correlation_heatmap.png", dpi=150)
    plt.close()

    plt.figure(figsize=(9, 6))
    points = plt.scatter(
        df["Longitude"],
        df["Latitude"],
        c=df["MedHouseVal"],
        s=df["Population"] / 100,
        cmap="viridis",
        alpha=0.5,
    )
    plt.colorbar(points, label="Median house value (units of $100,000)")
    plt.xlabel("Longitude")
    plt.ylabel("Latitude")
    plt.title("California Housing Values by Location")
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / "geographical_distribution.png", dpi=150)
    plt.close()


def main():
    df = load_data()

    print("\n--- Dataset overview ---")
    print("Shape:", df.shape)
    print("\nData types and non-null counts:")
    df.info()
    print("\nMissing values:")
    print(df.isnull().sum())
    print("\nSummary statistics:")
    print(df.describe().T)

    save_eda_plots(df)

    X = df.drop(columns="MedHouseVal")
    y = df["MedHouseVal"]

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=TEST_SIZE, random_state=RANDOM_STATE
    )

    # Scaling is fitted on the training data only. The pipeline prevents
    # test-data leakage during fitting and cross-validation.
    models = {
        "Linear Regression": Pipeline([
            ("scaler", StandardScaler()),
            ("model", LinearRegression()),
        ]),
        "Ridge Regression": Pipeline([
            ("scaler", StandardScaler()),
            ("model", Ridge(alpha=1.0)),
        ]),
        "Decision Tree": Pipeline([
            ("scaler", StandardScaler()),
            ("model", DecisionTreeRegressor(
                max_depth=5, random_state=RANDOM_STATE
            )),
        ]),
    }

    results = {}
    fitted_models = {}

    print("\n--- Model evaluation ---")
    for name, model in models.items():
        model.fit(X_train, y_train)
        predictions = model.predict(X_test)

        mae = mean_absolute_error(y_test, predictions)
        rmse = mean_squared_error(y_test, predictions) ** 0.5
        r2 = r2_score(y_test, predictions)

        # Negative RMSE is used by scikit-learn's scoring convention.
        cv_scores = cross_val_score(
            model, X_train, y_train, cv=5, scoring="neg_root_mean_squared_error"
        )
        cv_rmse = -cv_scores.mean()

        results[name] = {
            "Test MAE": mae,
            "Test RMSE": rmse,
            "Test R2": r2,
            "5-Fold CV RMSE": cv_rmse,
        }
        fitted_models[name] = model

        print(f"\n{name}")
        print(f"  Test MAE:       {mae:.4f}")
        print(f"  Test RMSE:      {rmse:.4f}")
        print(f"  Test R²:        {r2:.4f}")
        print(f"  5-Fold CV RMSE: {cv_rmse:.4f}")

    results_df = pd.DataFrame(results).T.sort_values("Test RMSE")
    print("\n--- Comparison table (lower MAE/RMSE is better; higher R² is better) ---")
    print(results_df.round(4))

    OUTPUT_DIR.mkdir(exist_ok=True)
    results_df.to_csv(OUTPUT_DIR / "model_comparison.csv")

    ax = results_df[["Test RMSE", "5-Fold CV RMSE"]].plot(
        kind="bar", figsize=(10, 5), title="Model RMSE Comparison"
    )
    ax.set_ylabel("RMSE (units of $100,000)")
    ax.tick_params(axis="x", rotation=15)
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / "model_rmse_comparison.png", dpi=150)
    plt.close()

    best_name = results_df["Test RMSE"].idxmin()
    best_model = fitted_models[best_name]
    best_predictions = best_model.predict(X_test)

    print(f"\nBest model by test RMSE: {best_name}")
    print("Example predictions (actual and predicted; units of $100,000):")
    examples = pd.DataFrame({
        "Actual": y_test.iloc[:5].to_numpy(),
        "Predicted": best_predictions[:5],
    })
    print(examples.round(3).to_string(index=False))

    fig, ax = plt.subplots(1, 2, figsize=(11, 4))
    ax[0].scatter(y_test, best_predictions, alpha=0.4)
    low = min(y_test.min(), best_predictions.min())
    high = max(y_test.max(), best_predictions.max())
    ax[0].plot([low, high], [low, high], "r--")
    ax[0].set_xlabel("Actual house value")
    ax[0].set_ylabel("Predicted house value")
    ax[0].set_title(f"Actual vs Predicted: {best_name}")

    residuals = y_test.to_numpy() - best_predictions
    sns.histplot(residuals, bins=40, kde=True, ax=ax[1])
    ax[1].set_title("Residual Distribution")
    ax[1].set_xlabel("Actual - predicted")
    plt.tight_layout()
    plt.savefig(OUTPUT_DIR / "best_model_diagnostics.png", dpi=150)
    plt.close()

    # Save the complete pipeline so the same preprocessing is applied later.
    joblib.dump(best_model, MODEL_PATH)
    print(f"\nSaved model to: {MODEL_PATH.resolve()}")
    print(f"Saved plots and results to: {OUTPUT_DIR.resolve()}")

    # Reload and verify that the saved model can make predictions.
    loaded_model = joblib.load(MODEL_PATH)
    print("Reloaded model sample predictions:")
    print(loaded_model.predict(X_test.iloc[:3]).round(3))


if __name__ == "__main__":
    main()
